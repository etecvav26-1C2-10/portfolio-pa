    # Descrição: Lê um número inteiro positivo e exibe a contagem de 1 até esse número.


numero = int(input("Digite um número inteiro positivo: "))

if numero > 0:
    contador = 1
    
    while contador <= numero:
        print(contador)
        contador += 1
else:
    print("Número invalido. Digite um valor positivo.")

